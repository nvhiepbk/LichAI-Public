{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "category",
    "logo_url",
    "source_repository",
    "workflow",
    "artifact",
    "version_source",
    "changelog_path",
    "info_url",
    "guide_url",
    "channel",
    "update_policy",
    "visible",
    "legacy_key",
    "installers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "logo_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^nvhiepbk/[A-Za-z0-9_.-]+$"
    },
    "workflow": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.yml$"
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "version_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "gradle",
            "tauri",
            "text",
            "studio"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+$"
        }
      }
    },
    "changelog_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./-]+$"
    },
    "info_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "guide_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "channel": {
      "const": "stable"
    },
    "update_policy": {
      "enum": [
        "optional",
        "required"
      ]
    },
    "visible": {
      "type": "boolean"
    },
    "legacy_key": {
      "enum": [
        "android",
        "android_tv",
        "windows",
        null
      ]
    },
    "installers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "format",
          "asset",
          "pattern",
          "os_requirement",
          "signature_policy"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "format": {
            "enum": [
              "apk",
              "exe",
              "msi",
              "zip",
              "deb",
              "rpm",
              "pkg",
              "dmg",
              "AppImage"
            ]
          },
          "asset": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$"
          },
          "pattern": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.*-]+$"
          },
          "os_requirement": {
            "type": "string"
          },
          "signature_policy": {
            "enum": [
              "required",
              "record-unsigned"
            ]
          }
        }
      }
    },
    "downloader_code": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "description_long": {
      "type": "string",
      "maxLength": 20000
    },
    "build_workflow_url": {
      "type": "string",
      "pattern": "^https://github.com/"
    }
  }
}
